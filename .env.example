# ─────────────────────────────────────────────────────────────
# KINS 일일 언론동향 검색 - 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.  (.env 는 Git 에 올리지 않습니다)
# ─────────────────────────────────────────────────────────────

# [필수] 네이버 뉴스 검색 API - NAVER Cloud Platform > NAVER API HUB > Application 에서 발급
#        ('검색 API' 등록 필요). 요청 시 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY 헤더로 전송됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [외부 공개 시 필수] 접속 비밀번호 - 설정하면 비밀번호를 아는 사람만 사용할 수 있습니다.
APP_PASSWORD=

# [선택] LLM 보조 판단 (OpenAI 호환 Chat Completions API)
# 두 값이 모두 있어야 사용됩니다. 모델명은 코드에 고정하지 않으므로 반드시 지정하세요.
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenAI 호환 사내 게이트웨이 등을 쓰는 경우에만 변경 (기본: https://api.openai.com/v1)
OPENAI_BASE_URL=

# [선택] 동작 조정 (비워두면 기본값)
# 외부 요청 timeout(초)
HTTP_TIMEOUT=10
# 네이버 API 재시도 횟수
HTTP_RETRIES=3
# 키워드당 최대 조회 건수 (100~1000, 네이버 API 한도 1000)
NAVER_MAX_RESULTS_PER_KEYWORD=1000
# 기사 원문 확인 여부 (true/false)
FETCH_ARTICLE_TEXT=true
# 원문 확인 동시 요청 수
ARTICLE_FETCH_WORKERS=10
# LLM 한 번에 판단할 기사 수 / 동시 요청 수 / 같은 사건 판단 최대 쌍 수
LLM_BATCH_SIZE=8
LLM_WORKERS=4
LLM_MAX_PAIR_CHECKS=80
